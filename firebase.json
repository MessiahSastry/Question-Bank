{
  "hosting": {
    "public": "firebase-site",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/zoom/oauth/start",
        "function": {
          "functionId": "zoomOAuthStart",
          "region": "asia-south1"
        }
      },
      {
        "source": "/zoom/oauth/callback",
        "function": {
          "functionId": "zoomOAuthCallback",
          "region": "asia-south1"
        }
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    },
    {
      "source": "zoom-functions",
      "codebase": "zoom",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ]
}
